Float LastGetSecondsPassedSeconds_p = 0.0
Float Function GetSecondsPassed()
	float returnValue = 0.0
	If LastGetSecondsPassedSeconds_p != 0.0
		returnValue = Utility.GetCurrentRealTime() - LastGetSecondsPassedSeconds_p
		;Sometimes returnValue is negative (witnessed after loading a save).
		;The above two function calls resulted in 21.345001 - 620.765015.
		;Since LastGetSecondsPassedSeconds_p is set at the bottom of this function,
		;I'm guessing Utility.GetCurrentRealTime() returns a much greater value on the first call than on subsequent calls.
		If returnValue < 0
			returnValue = 0
		EndIf
	EndIf
	LastGetSecondsPassedSeconds_p = Utility.GetCurrentRealTime()
	return returnValue
EndFunction